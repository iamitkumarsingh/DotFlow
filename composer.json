{
  "name": "dotflow/dotflow",
  "description": "AI-powered CRM, email marketing and automation for WordPress, derived from Groundhogg under GPLv3.",
  "minimum-stability": "stable",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "DotFlow contributors"
    },
    {
      "name": "Groundhogg Inc.",
      "email": "info@groundhogg.io",
      "role": "Original authors of the GPLv3-derived foundation"
    }
  ],
  "require": {
    "php": ">=8.0",
    "ext-json": "*",
    "ext-mysqli": "*",
    "ext-imap": "*",
    "ext-openssl": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "yoast/phpunit-polyfills": "^2.0"
  },
  "scripts": {
    "lint:php": "phpcs",
    "lint:php:fix": "phpcbf",
    "wpcs:doctor": "phpcs -i && phpcs --config-show",
    "cs:check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
    "cs:fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
